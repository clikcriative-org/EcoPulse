# ══════════════════════════════════════════════════════════
# ECOPULSE — Environment Variables
# Copy to .env and fill in real values
# ══════════════════════════════════════════════════════════

# ── App ──
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:3001
PORTAL_URL=http://localhost:3002

# ── Database ──
DATABASE_URL="postgresql://ecopulse:ecopulse_dev@localhost:5432/ecopulse?schema=public"

# ── Redis ──
REDIS_URL="redis://localhost:6379"

# ── Auth (JWT) ──
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=900
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
REFRESH_TOKEN_EXPIRES_IN=604800

# ── Stripe ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── WhatsApp (Meta Cloud API) ──
WHATSAPP_API_VERSION=v17.0
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# ── File Storage (S3/R2) ──
S3_BUCKET=ecopulse-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ── Email (SMTP) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EcoPulse <noreply@ecopulse.com.br>"

# ── Sentry ──
SENTRY_DSN=

# ── Misc ──
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
LOG_LEVEL=debug
