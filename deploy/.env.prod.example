# ============================================================
# ECOPULSE — Production Environment (ecopulse.art / VPS Hostinger + Traefik)
# Copie para deploy/.env.prod e preencha. NUNCA comite o .env.prod.
# ============================================================

NODE_ENV=production

# ── Database (interno ao Compose; sem porta exposta no host) ──
DB_USER=ecopulse
DB_PASSWORD=TROQUE_SENHA_FORTE_DB
DB_NAME=ecopulse

# ── Redis ──
REDIS_PASSWORD=TROQUE_SENHA_REDIS

# ── JWT (gere cada um com: openssl rand -base64 48) ──
JWT_SECRET=TROQUE_GERE_COM_OPENSSL
REFRESH_TOKEN_SECRET=TROQUE_GERE_COM_OPENSSL_2

# ── CORS: origens do frontend que podem chamar a API ──
CORS_ORIGINS=https://ecopulse.art,https://www.ecopulse.art

# ── URL pública da API (inlinada no build do frontend) ──
NEXT_PUBLIC_API_URL=https://api.ecopulse.art/api/v1
