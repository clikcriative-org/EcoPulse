# Copie para .env (o setup.sh faz isso e gera a chave sozinho)

# Chave de administrador da API. Gere com:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
OMNIVOICE_API_KEY=

# Versão fixa da imagem (veja https://github.com/debpalash/VoiceStudio/releases)
VOICESTUDIO_TAG=0.5.6

# Opcional: token do Hugging Face para modelos com acesso restrito
HF_TOKEN=

# n8n (perfil opcional)
TZ=America/Sao_Paulo
N8N_TAG=latest
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
